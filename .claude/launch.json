{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-c", "source .venv/bin/activate && exec uvicorn backend.main:app --host 127.0.0.1 --port 8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-c", "source .venv/bin/activate && exec streamlit run frontend/streamlit/streamlit_app.py --server.port 8501 --server.headless true"],
      "port": 8501
    },
    {
      "name": "frontend-react",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-c", "cd frontend/react && npm run dev -- --port 5173"],
      "port": 5173
    }
  ]
}
