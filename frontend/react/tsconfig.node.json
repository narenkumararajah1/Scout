{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    // A composite project must emit, and with no outDir it wrote
    // vite.config.js and vite.config.d.ts next to the source. Vite resolves
    // vite.config.js *before* vite.config.ts, so every `tsc -b` silently
    // replaced the real config with a stale compiled copy - which is how a
    // proxy change appeared to be ignored twice. Emitting into node_modules
    // keeps the build outputs out of the way of the thing they describe.
    "outDir": "./node_modules/.tmp/tsconfig-node"
  },
  "include": ["vite.config.ts"]
}
