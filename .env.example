# Application
APP_NAME=Scout
ENVIRONMENT=development

# FastAPI backend
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000

# Streamlit frontend
STREAMLIT_HOST=127.0.0.1
STREAMLIT_PORT=8501
BACKEND_URL=http://127.0.0.1:8000

# SQLite
SQLITE_PATH=data/scout.db

# ChromaDB
CHROMA_PERSIST_DIR=data/chroma
CHROMA_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Knowledge Agent - used starting Phase 2 Day 8. Place .txt/.md files here
# (case studies, whitepapers, service offerings) to be ingested on startup.
KNOWLEDGE_SOURCES_DIR=data/knowledge_sources

# LiteLLM / Claude - used starting Phase 1 Day 3 (Google ADK integration)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Research Agent - used starting Phase 2 Day 6
TARGET_COMPANY=Example Prospect Co.

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/scout.log
