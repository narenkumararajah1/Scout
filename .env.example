# Application
APP_NAME=Scout
ENVIRONMENT=development

# FastAPI backend
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000

# Streamlit frontend
STREAMLIT_HOST=127.0.0.1
STREAMLIT_PORT=8501
BACKEND_URL=http://127.0.0.1:8000

# SQLite
SQLITE_PATH=data/scout.db

# ChromaDB
CHROMA_PERSIST_DIR=data/chroma
CHROMA_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Knowledge Agent - used starting Phase 2 Day 8. Place .txt/.md files here
# (case studies, whitepapers, service offerings) to be ingested on startup.
KNOWLEDGE_SOURCES_DIR=data/knowledge_sources

# LiteLLM / LLM provider - used starting Phase 1 Day 3 (Google ADK integration).
# LLM_PROVIDER selects which key + model prefix backend/llm_client.py uses:
# "anthropic" (default, Claude) or "google" (Gemini). Set LLM_MODEL to a
# model name valid for whichever provider is selected - do not mix e.g.
# LLM_PROVIDER=google with a Claude model name. See ADR-023 for the
# temporary Gemini migration this supports.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# Google AI Studio (Gemini Developer API) key - only used when
# LLM_PROVIDER=google. Get one at https://aistudio.google.com/apikey.
# If switching to Gemini, also set LLM_MODEL=gemini-pro-latest (or another
# valid Gemini model id).
GOOGLE_API_KEY=

# Research Agent - used starting Phase 2 Day 6
TARGET_COMPANY=Example Prospect Co.

# APScheduler - used starting Phase 4 Day 18. How often Scout automatically
# runs the full workflow.
SCHEDULER_INTERVAL_HOURS=24

# Email notifications - used starting Phase 4 Day 18. Leave blank to skip
# sending (Reporting Agent will log and continue rather than fail).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/scout.log
